// ============================================================
// nextflow.config — P3 Nextflow 工作流配置
//
// 三个 profile（SPEC §2）：
//   standard : 服务器实际运行，无容器，依赖 PATH 上的 python3 / Rscript
//   docker   : 本机 / CI，容器 thesis-python:3.7.10 / thesis-r:4.2.0
//   test     : 冒烟，只覆盖 params（排除样本），与 standard/docker 组合
//
// 本机 standard 的 interpreter 用 Windows 原生 python/R（HANDOFF §1.3：
// 不要用 WSL 的 python3/Rscript）。Nextflow 本身跑在 WSL（不支持原生 Windows），
// 通过 /mnt/d、/mnt/f 跨调用 Windows 解释器与 Windows 文件系统。服务器侧通过
//   -profile standard --python python3 --rscript Rscript
// 覆盖回 PATH 上的解释器。
// ============================================================

params {
    // --- fixture 路径（两段解耦，见 NEXTFLOW_NOTES.md）---
    // fixture_container: registry 内嵌的绝对路径（挂载目标 / 容器内路径）。
    //   sample_registry.json 的 path 字段硬编码了这一前缀，因此该值必须与
    //   registry 保持一致，换机需连同 registry 一起重建。
    fixture_container = '/tmp/p1_verify_20260812_182813/fixture'
    // fixture_host: fixture 在本机 host 上的实际位置（docker 挂载源）。
    //   注意：Nextflow 在 WSL 中运行，故这里是 WSL 路径（/mnt/f = F:）。
    fixture_host = '/mnt/f/Thesis/scripts_Final/Scripts_New/docker/c5_verify/p1_verify_20260812_182813/fixture'

    registry          = "${params.fixture_container}/sample_registry.json"

    // --- 排除项（显式常量，不用模式匹配；复用同一套子集生成机制）---
    // test_exclude: test 冒烟子集排除的样本（全流程生效，运行时打印原因）
    test_exclude      = []
    // r_stage_exclude: R 阶段排除 Donor2（Obs 17），运行时打印原因
    r_stage_exclude   = ['Fixture_Human/Donor2']

    // 解释器（standard 用；docker profile 覆盖为容器内 python / Rscript）。
    // 指向 Windows 原生解释器（/mnt/d = D:），满足 HANDOFF §1.3「不用 WSL 的
    // python3/Rscript」——WSL 只调度，计算仍由 Windows 解释器完成。
    python            = '/mnt/d/python3.9.13/python.exe'
    rscript           = '/mnt/d/R-4.5.2/bin/Rscript.exe'

    // 发布目录
    outdir            = 'results'
}

profiles {

    standard {
        // 无容器：直接在 host 上跑 params.python / params.rscript
        // 关键：local executor 默认把输入文件 stage 成 symlink，而 Windows 原生
        // python/R 无法跟随 WSL 的 DrvFs symlink（Errno 22）。强制 copy。
        process.stageInMode = 'copy'
    }

    docker {
        docker.enabled = true
        // 把 host 上的 fixture 挂到容器内 fixture_container（registry 绝对路径成立）
        docker.runOptions = "-v ${params.fixture_host}:${params.fixture_container}"
        // 容器内是 PATH 上的 python / Rscript
        params.python  = 'python'
        params.rscript = 'Rscript'
        // 与 standard 一致强制 copy：local executor 默认 symlink 会让任务哈希
        // 不稳定（-resume 每次重算），copy 后哈希按内容确定，-resume 才能命中缓存。
        process.stageInMode = 'copy'
    }

    test {
        // 冒烟：Donor1 + Donor3 + MouseA（2 个 dataset，其中一个含 2 样本，
        // fan-in 与 fan-out 都能体现；同时避开 Donor2=Obs 17）。
        // 用子集 registry 而非 channel 过滤：P2A 脚本从完整 registry 反推 dataset
        // 样本列表并校验 manifest 完整性（Q4(b) fail-fast），channel 过滤会漏样本。
        params.test_exclude = ['Fixture_Human/Donor2', 'Fixture_Mouse/MouseB']
    }

}

trace {
    overwrite = true
    fields = ['task_id', 'hash', 'process', 'tag', 'name', 'status', 'exit',
              'cpus', 'time', 'duration', 'realtime', 'workdir', 'container']
}

report {
    overwrite = true
}

timeline {
    overwrite = true
}

dag {
    overwrite = true
}
